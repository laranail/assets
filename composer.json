{
    "name": "laranail/assets",
    "description": "An opinionated HTML asset manager for Laravel.",
    "type": "package",
    "license": "MIT",
    "keywords": [
        "simtabi",
        "simtabi cms",
        "simtabi platform",
        "simtabi git commit checker",
        "git",
        "commit checker"
    ],
    "homepage": "https://opensource.simtabi.com/products/laranail/assets",
    "authors": [
        {
            "name": "Imani Manyara",
            "role": "Developer",
            "homepage": "https://simtabi.com"
        },
        {
            "name": "Easter Mukora",
            "role": "Developer",
            "homepage": "https://simtabi.com"
        }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "illuminate/config": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.6"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Assets\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Assets\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Assets\\Providers\\AssetsServiceProvider"
            ],
            "aliases": {
                "Assets": "Simtabi\\Laranail\\Assets\\Facades\\AssetsFacade"
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "support": {
        "issues": "https://github.com/laranail/assets/issues",
        "source": "https://github.com/laranail/assets",
        "docs": "https://opensource.simtabi.com/documentation/laranail/assets/"
    },
    "prefer-stable": true
}
